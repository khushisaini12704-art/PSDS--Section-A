#include <iostream>
#include <vector>
#include <algorithm>
#include <cmath>
using namespace std;

// Calculate sum of absolute differences
long long calculateSum(vector<long long>& arr)
{
    long long sum = 0;

    for (int i = 0; i < arr.size() - 1; i++)
    {
        sum += abs(arr[i] - arr[i + 1]);
    }

    return sum;
}

int main()
{
    int n;

    cout << "Enter number of elements: ";
    cin >> n;

    vector<long long> arr(n);

    cout << "Enter elements: ";
    for (int i = 0; i < n; i++)
        cin >> arr[i];

    // Sort the array
    sort(arr.begin(), arr.end());

    vector<long long> result1, result2;

    int m = n / 2;

    // For even number of elements
    if (n % 2 == 0)
    {
        // Start from middle smaller element
        result1.push_back(arr[m - 1]);

        int low = m - 2;
        int high = n - 1;

        while (low >= 0)
        {
            result1.push_back(arr[high]);
            high--;

            result1.push_back(arr[low]);
            low--;
        }

        result1.push_back(arr[m]);
    }

    // For odd number of elements
    else
    {
        // Arrangement 1
        result1.push_back(arr[m - 1]);

        int low = 0;
        int high = m + 1;

        while (high < n)
        {
            result1.push_back(arr[high]);
            high++;

            if (low < m - 1)
            {
                result1.push_back(arr[low]);
                low++;
            }
        }

        result1.push_back(arr[m]);

        // Arrangement 2
        result2.push_back(arr[m]);

        low = 0;
        high = n - 1;

        while (low < m)
        {
            result2.push_back(arr[low]);
            low++;

            if (high > m + 1)
            {
                result2.push_back(arr[high]);
                high--;
            }
        }

        result2.push_back(arr[m + 1]);

        // Choose arrangement with maximum sum
        if (calculateSum(result2) > calculateSum(result1))
            result1 = result2;
    }

    cout << "\nRearranged Array: ";

    for (long long x : result1)
        cout << x << " ";

    cout << "\nMaximum Sum = " << calculateSum(result1);

    return 0;
}




#include <iostream>
using namespace std;

int main()
{
    int n, k;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter K: ";
    cin >> k;

    int arr[n];

    cout << "Enter array elements: ";
    for (int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }

    // Calculate sum of first window
    int windowSum = 0;

    for (int i = 0; i < k; i++)
    {
        windowSum += arr[i];
    }

    int maxSum = windowSum;

    // Slide the window
    for (int i = k; i < n; i++)
    {
        windowSum = windowSum + arr[i] - arr[i - k];

        if (windowSum > maxSum)
        {
            maxSum = windowSum;
        }
    } 

    cout << "Maximum sum = " << maxSum << endl;

    return 0;
}



#include <iostream>
#include <string>
using namespace std;

int main()
{
    string s;

    cout << "Enter a string: ";
    cin >> s;

    int last[26];

    // Initialize all positions with -1
    for (int i = 0; i < 26; i++)
    {
        last[i] = -1;
    }

    int left = 0;
    int maxLength = 0;

    for (int right = 0; right < s.length(); right++)
    {
        int index = s[right] - 'a';

        // If character was already seen
        if (last[index] >= left)
        {
            left = last[index] + 1;
        }

        last[index] = right;

        int currentLength = right - left + 1;

        if (currentLength > maxLength)
        {
            maxLength = currentLength;
        }
    }

    cout << "Length of longest substring = "
         << maxLength << endl;

    return 0;
}



#include <iostream>
#include <vector>
#include <climits>
using namespace std;

struct Edge
{
    int u;
    int v;
    int weight;
};

int main()
{
    int n, m, k;

    cout << "Enter number of nodes: ";
    cin >> n;

    cout << "Enter number of edges: ";
    cin >> m;

    cout << "Enter maximum number of edges K: ";
    cin >> k;

    vector<Edge> edges(m);

    cout << "Enter edges (u v weight):" << endl;

    for (int i = 0; i < m; i++)
    {
        cin >> edges[i].u
            >> edges[i].v
            >> edges[i].weight;
    }

    const int INF = INT_MAX / 2;

    // dp[e][node] = minimum cost using exactly e edges
    vector<vector<int>> dp(k + 1,
                           vector<int>(n + 1, INF));

    // Starting from node 1
    dp[0][1] = 0;

    for (int e = 1; e <= k; e++)
    {
        for (int i = 0; i < m; i++)
        {
            int u = edges[i].u;
            int v = edges[i].v;
            int w = edges[i].weight;

            // Undirected graph: u -> v
            if (dp[e - 1][u] != INF)
            {
                dp[e][v] =
                    min(dp[e][v],
                        dp[e - 1][u] + w);
            }

            // Undirected graph: v -> u
            if (dp[e - 1][v] != INF)
            {
                dp[e][u] =
                    min(dp[e][u],
                        dp[e - 1][v] + w);
            }
        }
    }

    int answer = INF;

    // At most K edges
    for (int e = 0; e <= k; e++)
    {
        answer = min(answer, dp[e][n]);
    }

    if (answer == INF)
    {
        cout << "Shortest path = -1" << endl;
    }
    else
    {
        cout << "Shortest path = " << answer << endl;
    }

    return 0;
}
